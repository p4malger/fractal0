# ═══════════════════════════════════════════════════════════════
#  EXEMPLE DE CONFIGURATION — copier ce fichier vers .env
#  نموذج الإعدادات — انسخ هذا الملف باسم ‎.env ثم عدّل القيم
# ═══════════════════════════════════════════════════════════════

# ─── 1) قاعدة البيانات (OBLIGATOIRE) ──────────────────────────
# Sur Vercel : collez ici la connexion Neon (voir DEPLOY.md, étape 2)
# مثال الرابط من Neon — انسخ الرابط الخاص بك من لوحة Neon:
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@HOST/NOM_BASE?sslmode=require"

# ─── 2) mot de passe de l'espace /admin (OBLIGATOIRE) ─────────
# ⚠️ Changez cette valeur — كلمة سر لوحة التحكم، غيّرها!
ADMIN_PASSWORD="VotreMotDePasseSecret2026"
